    plt.ylabel('Score (0.0 - 1.0)')
    
    # Add values on top of bars
    for i, v in enumerate(values):
        plt.text(i, v + 0.02, f"{v:.2f}", ha='center', fontsize=12)
    
    plt.tight_layout()
    plt.savefig('evaluation/metrics_summary.png')
