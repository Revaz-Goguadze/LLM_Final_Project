    for item in data["details"]:
        if "security" in item["file"]:
            found[0] += item["found"]
            expected[0] += item["expected"]
        elif "logic" in item["file"]:
            found[1] += item["found"]
            expected[1] += item["expected"]
        elif "performance" in item["file"]:
            found[2] += item["found"]
