OPENAI_API_KEY=sk-your-openai-key
# Gemini API (LLM calls)
GEMINI_API_KEY=your-gemini-key
# LLM provider: gemini (default) or openai
LLM_PROVIDER=gemini
# Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Zhipu AI GLM-4 (z.ai / BigModel) - OpenAI compatible
# Uncomment to use GLM-4:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-zhipu-ai-api-key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL_JUDGE=glm-4
# LLM throttling (seconds)
LLM_MIN_DELAY=1.2
# LLM retries
LLM_MAX_RETRIES=3
# Optional request timeout (seconds) for OpenAI calls:
# OPENAI_TIMEOUT=60
# Optional verification command for fix loop:
# VERIFY_COMMAND="pytest -q"
