OPENAI_API_KEY=sk-your-openai-key
# Gemini API (LLM calls)
GEMINI_API_KEY=your-gemini-key
# LLM provider: gemini (default) or openai
LLM_PROVIDER=gemini
# Gemini model
GEMINI_MODEL=gemini-2.0-flash
# LLM throttling (seconds)
LLM_MIN_DELAY=1.2
# LLM retries
LLM_MAX_RETRIES=3
# Optional request timeout (seconds) for OpenAI calls:
# OPENAI_TIMEOUT=60
# Optional verification command for fix loop:
# VERIFY_COMMAND="pytest -q"
